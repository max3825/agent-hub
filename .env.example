# Copier vers .env (jamais commité). Aucune clé n'est requise pour lancer le site de démo.

# Token GitHub (lecture publique suffit). Sans lui : 60 req/h seulement, la recherche de code est indisponible.
GITHUB_TOKEN=

# Optionnel : résumés via l'API Anthropic (Haiku). Sans clé → résumé de repli (frontmatter / README).
ANTHROPIC_API_KEY=
# Modèle utilisé pour les résumés (par défaut : claude-haiku-5-5)
SUMMARY_MODEL=claude-haiku-5-5
# Garde-fou de budget : nombre max de résumés générés par exécution
MAX_SUMMARIES_PER_RUN=300

# Front : DATA_SOURCE=sample (démo, défaut) | real (data/items.json)
DATA_SOURCE=sample
