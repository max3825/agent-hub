{
  "name": "agent-hub-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prepare-data": "node scripts/prepare-data.mjs",
    "dev": "node scripts/prepare-data.mjs && vite",
    "dev:real": "DATA_SOURCE=real node scripts/prepare-data.mjs && vite",
    "build": "node scripts/prepare-data.mjs && tsc --noEmit && vite build",
    "build:real": "DATA_SOURCE=real npm run build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.26",
    "framer-motion": "^11.18.2",
    "lucide-react": "^1.69.0",
    "minisearch": "^7.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "tailwindcss": "3.4",
    "typescript": "^5.9.3",
    "vite": "^6.4.5"
  }
}
